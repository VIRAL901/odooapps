<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_inherited_sale_product_catalog" model="ir.ui.view">
        <field name="name">sale.order.form.catalog</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/tree/control">
                <button name="action_add_from_catalog" string="Catalog" type="object" class="px-4 btn-link" context="{'order_id': parent.id}"/>
            </xpath>
        </field>
    </record>

</odoo>
