<odoo>
    <data noupdate="1">
        <!-- Weekly Cron -->
        <record id="ir_cron_generate_weekly_po" model="ir.cron">
            <field name="name">Generate Weekly Purchase Order</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="state">code</field>
            <field name="code">model.generate_po('weekly')</field>
            <field name="interval_type">weeks</field>
            <field name="interval_number">1</field>
            <field name="active">True</field>
        </record>

        <!-- Monthly Cron -->
        <record id="ir_cron_generate_monthly_po" model="ir.cron">
            <field name="name">Generate Monthly Purchase Order</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="state">code</field>
            <field name="code">model.generate_po('monthly')</field>
            <field name="interval_type">months</field>
            <field name="interval_number">1</field>
            <field name="active">True</field>
        </record>

        <!-- Yearly Cron -->
        <record id="ir_cron_generate_yearly_po" model="ir.cron">
            <field name="name">Generate Yearly Purchase Order</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="state">code</field>
            <field name="code">model.generate_po('yearly')</field>
            <field name="interval_type">months</field>
            <field name="interval_number">12</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
