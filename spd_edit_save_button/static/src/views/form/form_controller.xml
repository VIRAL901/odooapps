<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="web.FormView" t-inherit-mode="extension">

        <xpath expr="//t[@t-set-slot='control-panel-create-button']/button[@t-if='canCreate']" position="after">

            <t t-if="!model.root.isInEdition and canEdit">
                <button type="button"
                        class="btn btn-outline-primary o_form_button_edit"
                        t-on-click="edit"
                        data-hotkey="a">
                    Edit
                </button>
            </t>

            <t t-if="model.root.isInEdition">
                <div class="o_form_buttons_edit d-inline-flex gap-1 ms-1">
                    <button id="editButton"
                            type="button"
                            class="btn btn-primary o_form_button_save"
                            t-on-click="saveButtonClicked"
                            data-hotkey="s"
                            title="Save">
                        <i class="fa fa-cloud-upload fa-fw"></i>
                    </button>

                    <button type="button"
                            class="btn btn-secondary o_form_button_cancel"
                            t-on-click="discard"
                            data-hotkey="j"
                            title="Discard">
                        <i class="fa fa-undo fa-fw"></i>
                    </button>
                </div>
            </t>
        </xpath>

        <xpath expr="//t[@t-set-slot='control-panel-status-indicator']" position="replace">
            <t t-set-slot="control-panel-status-indicator">
            </t>
        </xpath>

    </t>
</templates>
