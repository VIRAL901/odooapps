<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="web.FormView" t-inherit-mode="extension">
        <!-- After the FIRST "New" button -->
        <xpath expr="(//button[hasclass('o_form_button_create')])[1]" position="after">
            <t t-if="!canEdit and !model.root.isInEdition">
                <button type="button"
                        class="btn btn-outline-primary o_form_button_edit"
                        t-on-click="edit"
                        data-hotkey="a">
                    Edit
                </button>
            </t>
            <t t-if="model.root.isInEdition">
                <div class="o_form_buttons_edit d-inline-flex gap-1 ms-1">
                    <button type="button"
                            class="btn btn-primary o_form_button_save"
                            t-on-click="saveButtonClicked"
                            data-hotkey="s">
                        <i class="fa fa-cloud-upload fa-fw"/>
                    </button>
                    <button type="button"
                            class="btn btn-secondary o_form_button_cancel"
                            t-on-click="discard"
                            data-hotkey="j">
                        <i class="fa fa-undo fa-fw"/>
                    </button>
                </div>
            </t>
        </xpath>
        <!-- After the SECOND "New" button -->
        <xpath expr="(//button[hasclass('o_form_button_create')])[2]" position="after">
            <t t-if="!canEdit and !model.root.isInEdition">
                <button type="button"
                        class="btn btn-outline-primary o_form_button_edit"
                        t-on-click="edit"
                        data-hotkey="a">
                    Edit
                </button>
            </t>
            <t t-if="model.root.isInEdition">
                <div class="o_form_buttons_edit d-inline-flex gap-1 ms-1">
                    <button type="button"
                            class="btn btn-primary o_form_button_save"
                            t-on-click="saveButtonClicked"
                            data-hotkey="s">
                        <i class="fa fa-cloud-upload fa-fw"/>
                    </button>
                    <button type="button"
                            class="btn btn-secondary o_form_button_cancel"
                            t-on-click="discard"
                            data-hotkey="j">
                        <i class="fa fa-undo fa-fw"/>
                    </button>
                </div>
            </t>
        </xpath>
    </t>
</templates>