<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_form_view_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.form.view.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='languages']" position="before">
                <div id="currency_rate_api_key">
                    <h2>Currency Rate API</h2>
                    <div class="row mt16 o_settings_container" name="currency_rate_api_key">
                        <div class="col-xs-12 col-md-6 o_setting_box" id="currency_rate_api_setting">
                            <div class="w-100" style="margin-left:25px">
                                <label for="access_token" class="o_form_label"/>
                                <field name="access_token" string="API Key" password="True"
                                       class="w-100"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>